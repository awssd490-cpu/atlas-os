# ATLAS Configuration
# Copy to .env and adjust for your environment.

# Application
ATLAS_APP__ENVIRONMENT=development
ATLAS_APP__DEBUG=true

# Server
ATLAS_SERVER__HOST=0.0.0.0
ATLAS_SERVER__PORT=8000
ATLAS_SERVER__RELOAD=true

# Logging
ATLAS_LOGGING__LEVEL=DEBUG
ATLAS_LOGGING__FORMAT=colored

# Database (Phase 2+)
ATLAS_DATABASE__HOST=localhost
ATLAS_DATABASE__PORT=5432
ATLAS_DATABASE__DATABASE=atlas
ATLAS_DATABASE__USERNAME=postgres
ATLAS_DATABASE__PASSWORD=
